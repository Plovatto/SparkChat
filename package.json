{
  "name": "SparkChat-SPA",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "predev": "npm run models:fetch -- --dev",
    "build": "tsc -b && vite build",
    "prebuild": "npm run models:fetch",
    "models:fetch": "node scripts/fetch-translation-models.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "lighthouse": "lhci autorun"
  },
  "dependencies": {
    "@jitsi/rnnoise-wasm": "0.2.1",
    "@mkljczk/bergamot-translator": "0.4.16",
    "bootstrap": "^5.3.9",
    "date-fns": "^4.1.0",
    "frimousse": "0.4.0",
    "i18next": "^27.2.5",
    "libsodium-wrappers-sumo": "^0.8.4",
    "pdfjs-dist": "^6.5.438",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-bootstrap": "^2.10.7",
    "react-dom": "^19.0.0",
    "react-easy-crop": "6.2.4",
    "react-i18next": "^18.0.3",
    "react-icons": "^5.4.0",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.16.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.10",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^6.3.0",
    "emojibase-data": "18.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "fake-indexeddb": "^6.2.8",
    "fast-check": "^4.10.2",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.33",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
