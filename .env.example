VITE_API_URL=http://localhost:3001
VITE_SOCKET_URL=http://localhost:3001

# Optional: base URL for the translation models (e.g. an R2 bucket with CORS)
# VITE_TRANSLATION_MODELS_URL=

VITE_MEDIA_ORIGIN=

# Optional: pin the key transparency log public key (printed by the API's npm run kt:keygen)
# VITE_KT_LOG_PUBLIC_KEY=

# Optional: URL of the published signed tree head (witness), for example a GitHub Pages file
# VITE_KT_WITNESS_URL=
