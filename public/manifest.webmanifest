{
  "id": "/app/",
  "name": "SparkChat",
  "short_name": "SparkChat",
  "description": "Chat em tempo real com criptografia ponta a ponta, chamadas de voz e vídeo, envio de imagens, áudios e arquivos, temas personalizáveis e o assistente SparkAI.",
  "lang": "pt-BR",
  "dir": "ltr",
  "start_url": "/app/",
  "scope": "/app/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#14121f",
  "theme_color": "#6c5ce7",
  "categories": ["social", "communication"],
  "prefer_related_applications": false,
  "icons": [
    { "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "screenshots": [
    { "src": "/screenshots/app-wide.png", "sizes": "1280x800", "type": "image/png", "form_factor": "wide", "label": "Conversas e chat lado a lado no computador" },
    { "src": "/screenshots/app-narrow.png", "sizes": "720x1280", "type": "image/png", "form_factor": "narrow", "label": "Chat no celular" }
  ],
  "shortcuts": [
    {
      "name": "Novo chat",
      "short_name": "Novo chat",
      "description": "Começar uma conversa nova",
      "url": "/app/?action=new-chat",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
